---
import Layout from '@layouts/Layout.astro';
---

<Layout
	title="Support Us - Operations Paused"
	description="Tūhura Tech is currently not operating. Learn about our archive and past impact."
>
	<section class="flex items-center bg-gray-50 py-32">
		<div class="container-custom mx-auto max-w-2xl text-center">
			<h1 class="mb-6 text-4xl font-bold md:text-5xl">Support Us Page Retired</h1>
			<p class="mb-8 text-lg text-gray-600">
				Tūhura Tech is not currently accepting donations as we are not operating. However, we're forever
				grateful to everyone who supported our mission to bring free technology education to rangatahi across
				Wellington.
			</p>

			<div class="mb-12 rounded-xl border-l-4 border-tuhura-green bg-tuhura-gray p-6">
				<p class="text-gray-700">
					If you contributed to Tūhura Tech through donations, volunteering, or equipment support, thank you! Your
					generosity made an incredible difference in the lives of the rangatahi we served.
				</p>
			</div>

			<div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
				<a href="/" class="btn btn-primary">Home</a>
				<a href="/about-us" class="btn btn-secondary">Our Story</a>
				<a href="/contact" class="btn btn-outline">Get in Touch</a>
			</div>
		</div>
	</section>
</Layout>
